{
  "extends": "@crab-shack/platform-config/tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  // The layer's utils are plain TypeScript, so its unit tests typecheck here; app/ components and composables need Nuxt's generated types, which the distribution's nuxt typecheck covers.
