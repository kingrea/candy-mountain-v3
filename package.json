{
  "name": "candy-mountain",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": "please-use-pnpm",
    "pnpm": ">=12.15.0"
  },
  "scripts": {
    "preinstall": "node scripts/only-pnpm.mjs",
    "prepare": "platform-check-linked --install-hook",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "turbo run build",
    "lint": "platform-check-linked && turbo run lint lint:root",
    "lint:root": "eslint . --ignore-pattern 'apps/**' --ignore-pattern 'packages/**'",
    "typecheck": "turbo run typecheck --concurrency=1",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@crab-shack/platform-config": "0.4.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
